# Legacy courses in knowledge/courses.json
ANTHROPIC_API_KEY=

# Five-professor Arlington pilot
ATLAS_PILOT_ENABLED=false
ATLAS_DATA_DIR=
ATLAS_ENCRYPTION_KEY=
ATLAS_ADMIN_PASSWORD=
ATLAS_MAX_PILOT_PROFESSORS=5
# Anthropic model for legacy courses. Pilot courses store their own choice.
ATLAS_MODEL=claude-sonnet-4-6
ATLAS_SECURE_COOKIES=true
ATLAS_PUBLIC_BASE_URL=

# Optional comma-separated exact origins. Same-origin use needs no CORS entry.
ATLAS_ALLOWED_ORIGINS=
